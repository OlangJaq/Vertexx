# Environment Variables Template
# Copy this file to .env.local for development
# Copy this file to .env.production for production

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# API Base URL for backend endpoints
# Development: http://localhost:5000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:5000

# Environment flag
# Values: development, staging, production
VITE_ENVIRONMENT=development

# ==========================================
# M-PESA BACKEND CONFIGURATION
# (Only needed if running separate backend server)
# ==========================================

# Safaricom Daraja API Credentials
# Get from: https://developer.safaricom.co.ke/
SAFARICOM_CONSUMER_KEY=your_consumer_key_here
SAFARICOM_CONSUMER_SECRET=your_consumer_secret_here

# Your business shortcode
# Example: 123456
SAFARICOM_SHORTCODE=123456

# Passkey for your shortcode
# Get from Safaricom Business Portal
SAFARICOM_PASSKEY=your_passkey_here

# Initiator credentials for C2B transactions
SAFARICOM_INITIATOR_NAME=Initiator
SAFARICOM_INITIATOR_PASSWORD=your_initiator_password_here

# ==========================================
# DATABASE CONFIGURATION
# (Only if using separate database)
# ==========================================

# Database connection string
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db
# MongoDB example:
# DATABASE_URL=mongodb://user:password@localhost:27017/portfolio_db

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Node.js environment
# Values: sandbox, production
NODE_ENV=sandbox

# Server port (backend only)
PORT=5000

# ==========================================
# EMAIL CONFIGURATION
# (Optional - for sending transaction notifications)
# ==========================================

# SMTP email service
# Common: Gmail, SendGrid, AWS SES
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Email addresses for notifications
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=info@yourdomain.com

# ==========================================
# STRIPE/PAYMENT ALTERNATIVES
# (If using Stripe instead of M-Pesa)
# ==========================================

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ==========================================
# MONITORING & ANALYTICS
# (Optional)
# ==========================================

# Sentry error tracking
# SENTRY_AUTH_TOKEN=your_token_here
# SENTRY_DSN=https://key@sentry.io/project

# Google Analytics
# NEXT_PUBLIC_GA_ID=GA-XXXXXXXXX-X

# ==========================================
# DEPLOYMENT CONFIGURATION
# ==========================================

# Vercel deployment-specific
# VERCEL_URL will be auto-populated by Vercel
# VERCEL_ENV=preview or production

# ==========================================
# NOTES
# ==========================================

# 1. Never commit .env files to git
# 2. Always use environment-specific variables
# 3. Keep sensitive keys secure
# 4. Rotate keys regularly
# 5. Use different keys for development and production
# 6. Document any custom variables your team uses
